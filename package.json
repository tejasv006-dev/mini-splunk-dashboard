{
  "name": "mini-splunk-workspace",
  "version": "1.0.0",
  "description": "Root workspace to run seamlessly",
  "scripts": {
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
    "mock-data": "cd backend && npm run generate-logs",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "dev:all": "concurrently \"npm run server\" \"npm run client\" \"npm run mock-data\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
